OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/degreebaba
FRONTEND_URL=http://localhost:5173

# Image storage (uploaded via /upload-image) — copy straight from the
# Cloudinary console's "Product Environment Credentials" panel.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# WordPress publishing (Application Password auth — WP Admin > Users > Profile > Application Passwords)
WORDPRESS_SITE_URL=https://your-wordpress-site.com
WORDPRESS_APP_USER=your_wp_username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: only needed if your CPT slugs differ from "university"/"course"/"specialization"
# WORDPRESS_POST_TYPE_UNIVERSITY=university
# WORDPRESS_POST_TYPE_COURSE=course
# WORDPRESS_POST_TYPE_SPECIALIZATION=specialization

# Base URL this backend is reachable at — only used if CLOUDINARY_URL is
# unset, as a local-dev fallback image URL (see /upload-image).
BACKEND_PUBLIC_URL=http://localhost:8000

